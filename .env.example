# Bridge listener (keep on loopback when using Tailscale Serve)
HOST=127.0.0.1
PORT=8787

# Shared secret for Grok Voice / operators calling this bridge
BRIDGE_API_KEY=replace-with-long-random-bridge-key

# OpenClaw gateway (same machine or Tailscale IP)
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_TIMEOUT_SECONDS=60
OPENCLAW_DEFAULT_AGENT=main
OPENCLAW_SESSION_KEY=main

# gateway | telegram | hybrid
BACKEND_MODE=gateway

# Safety: start read-only
REQUIRE_CONFIRMATION=true
ENABLE_WRITE_TOOLS=false
RATE_LIMIT_PER_MINUTE=60
AUDIT_LOG_PATH=/var/log/openclaw-voice-bridge/audit.jsonl

# Optional Telegram temporary bridge (BACKEND_MODE=telegram|hybrid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

COMPANY_NAME=QDS Systems
VOICE_AGENT_NAME=OpenClaw Voice Control
ALLOW_ORIGINS=*
