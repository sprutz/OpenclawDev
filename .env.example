# Bridge listener (keep on loopback when using Tailscale Serve)
HOST=127.0.0.1
PORT=8787

# Shared secret for Grok Voice / operators calling this bridge
BRIDGE_API_KEY=replace-with-long-random-bridge-key

# OpenClaw gateway (same machine or Tailscale IP)
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_TIMEOUT_SECONDS=60
OPENCLAW_DEFAULT_AGENT=main
OPENCLAW_SESSION_KEY=main

# gateway | telegram | hybrid
BACKEND_MODE=gateway

# Safety: start read-only
REQUIRE_CONFIRMATION=true
ENABLE_WRITE_TOOLS=false
RATE_LIMIT_PER_MINUTE=60
AUDIT_LOG_PATH=/var/log/openclaw-voice-bridge/audit.jsonl

# Optional Telegram temporary bridge (BACKEND_MODE=telegram|hybrid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

COMPANY_NAME=QDS Systems
VOICE_AGENT_NAME=OpenClaw Voice Control
# JSON list or comma-separated origins
ALLOW_ORIGINS=["*"]

# Comma-separated Funnel/MagicDNS hostnames allowed by MCP Host checks
# Example: your-vps.tailnet.ts.net
MCP_PUBLIC_HOSTS=
# Optional full MCP URL for /v1/voice-agent/session (defaults to https://<first MCP_PUBLIC_HOSTS>/mcp)
MCP_PUBLIC_URL=
# Optional — mint realtime client secrets via POST /v1/voice-agent/client-secret
XAI_API_KEY=

# Second Brain knowledge store (read-only for voice tools)
SECOND_BRAIN_ROOT=/home/stan/clawd/second-brain

# Spoken voice unlock (empty disables the gate).
# Prefer a single compacted token (no spaces) — STT/tool-calling is unreliable with spaces.
# Example spoken phrase "pursue with enthusiasm" -> pursuewithenthusiasm
VOICE_SPOKEN_PASSWORD=pursuewithenthusiasm
# Unlock duration after a correct passphrase (seconds). Default 8 hours.
VOICE_UNLOCK_TTL_SECONDS=28800
